#version 460
layout(local_size_x=8,local_size_y=8,local_size_z=1) in;
layout(binding=0) uniform sampler2D highImage;
layout(binding=1) uniform sampler2D lowImage;
layout(binding=2,rgba16f) uniform writeonly image2D outputImage;
layout(binding=3,r32f) uniform readonly image2D exposureImage; // 1x1 linear exposure scale
layout(push_constant) uniform Filter { float lowMix; int upsample; int clampHighlights; } pc;

vec3 finiteRadiance(vec3 value) {
    return vec3(isnan(value.r)||isinf(value.r)?0.0:clamp(value.r,0.0,65504.0),
                isnan(value.g)||isinf(value.g)?0.0:clamp(value.g,0.0,65504.0),
                isnan(value.b)||isinf(value.b)?0.0:clamp(value.b,0.0,65504.0));
}
float luma(vec3 c){return dot(c,vec3(.2126,.7152,.0722));}
vec3 tap(vec2 uv){return finiteRadiance(textureLod(highImage,uv,0).rgb);}
// Karis average: weight a box by 1/(1+displayed luma) so one sub-pixel highlight cannot carry the whole
// block. Scene radiance is tiny before exposure, so the luma is taken after the 1x1 exposure scale.
float exposureScale;
float karis(vec3 c){return 1.0/(1.0+luma(c)*exposureScale);}

void main() {
    ivec2 p=ivec2(gl_GlobalInvocationID.xy),size=imageSize(outputImage);
    if(any(greaterThanEqual(p,size)))return;
    vec2 uv=(vec2(p)+.5)/vec2(size);
    vec3 color;
    if(pc.upsample!=1) {
        // 13-tap downsample (five overlapping bilinear 2x2 boxes), scene-linear HDR, never thresholded. The
        // old 2x2 box let sub-pixel shimmer on far silhouettes against a bright sky alias straight into the
        // wide levels, where it pulsed as bloom flicker. Mode 2 (first level) also Karis-averages the boxes.
        vec2 t=1.0/vec2(textureSize(highImage,0));
        vec3 a=tap(uv+t*vec2(-2,-2)),b=tap(uv+t*vec2(0,-2)),c=tap(uv+t*vec2(2,-2));
        vec3 d=tap(uv+t*vec2(-1,-1)),e=tap(uv+t*vec2(1,-1));
        vec3 f=tap(uv+t*vec2(-2,0)),g=tap(uv),h=tap(uv+t*vec2(2,0));
        vec3 i=tap(uv+t*vec2(-1,1)),j=tap(uv+t*vec2(1,1));
        vec3 k=tap(uv+t*vec2(-2,2)),l=tap(uv+t*vec2(0,2)),m=tap(uv+t*vec2(2,2));
        vec3 center=(d+e+i+j)*.25,tl=(a+b+f+g)*.25,tr=(b+c+g+h)*.25,bl=(f+g+k+l)*.25,br=(g+h+l+m)*.25;
        if(pc.upsample==2) {
            exposureScale=max(imageLoad(exposureImage,ivec2(0)).r,0.0);
            float wc=karis(center)*.5,w0=karis(tl)*.125,w1=karis(tr)*.125,w2=karis(bl)*.125,w3=karis(br)*.125;
            color=(center*wc+tl*w0+tr*w1+bl*w2+br*w3)/max(wc+w0+w1+w2+w3,1e-6);
        } else {
            color=center*.5+(tl+tr+bl+br)*.125;
        }
        if(pc.clampHighlights!=0) {
            // Reference BLOOM_CLAMP_STRENGTH=1 on the first half-resolution level: a soft knee that limits
            // a pixel's bloom contribution to ~21*exposure^0.85, so the sun disc and hot speculars do not
            // flood the wide levels. Values below half the limit pass unchanged.
            float limit=pow(max(imageLoad(exposureImage,ivec2(0)).r,0.0),0.85)*21.0+5e-5;
            float l=length(color)+1e-13;
            vec3 dir=color/l;
            l=min(l/limit,1.5);
            if(l>0.5){l-=1.5;l=1.0-l*l*0.5;}
            color=dir*l*limit;
        }
    } else {
        // 3x3 separable tent, DC gain exactly 1. Distinct output avoids sampled/storage feedback.
        vec2 d=1.0/vec2(textureSize(lowImage,0));
        vec3 low=vec3(0);
        for(int y=-1;y<=1;y++)for(int x=-1;x<=1;x++)
            low+=textureLod(lowImage,uv+vec2(x,y)*d,0).rgb*float((x==0?2:1)*(y==0?2:1))*.0625;
        color=mix(textureLod(highImage,uv,0).rgb,low,pc.lowMix);
    }
    imageStore(outputImage,p,vec4(finiteRadiance(color),1));
}
