#version 460

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0, set = 0, rgba16f) uniform readonly image2D colorImage;
layout(std430, binding = 1, set = 0) buffer Histogram {
    uint bins[512];
} hist;

layout(push_constant) uniform Meter { int itrpLook; } pc;

const float LOG_MIN = -12.0;
const float LOG_MAX = 12.0;
const float INV_LOG_RANGE = 1.0 / (LOG_MAX - LOG_MIN);

// One 16x16 workgroup == 256 threads == 256 bins, so each thread owns exactly one bin for the
// zero-init and the final flush. Per-pixel atomics land in shared memory (one SM, fast) instead of
// the global buffer (contended across the whole dispatch — sky pixels alias to the same few bins),
// then only the non-empty bins pay a single global atomicAdd each.
shared uint localBins[256];

void main() {
    uint localIdx = gl_LocalInvocationIndex;
    if (pc.itrpLook != 0) {
        // Equal-area 32x16 meter, 4x4 sub-samples per cell. Replaces the histogram dispatch, not an extra pass.
        uint sampleId = gl_WorkGroupID.x * 256u + localIdx;
        ivec2 size = imageSize(colorImage);
        vec2 cell = vec2(sampleId % 32u, sampleId / 32u);
        float luminance = 0.0;
        for (int y=0;y<4;y++) for(int x=0;x<4;x++) {
            vec2 uv = (cell + (vec2(x,y)+0.5)/4.0) / vec2(32.0,16.0);
            vec3 rgb = max(imageLoad(colorImage,clamp(ivec2(uv*vec2(size)),ivec2(0),size-1)).rgb,vec3(0.0));
            float value = dot(rgb,vec3(0.2126,0.7152,0.0722));
            luminance += isnan(value) || isinf(value) ? 0.0 : value;
        }
        hist.bins[sampleId] = floatBitsToUint(luminance/16.0);
        return;
    }
    localBins[localIdx] = 0u;
    barrier();

    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(colorImage);
    if (pix.x < size.x && pix.y < size.y) {
        vec3 rgb = max(imageLoad(colorImage, pix).rgb, vec3(0.0));
        float lum = dot(rgb, vec3(0.2126, 0.7152, 0.0722));
        float logLum = clamp(log2(max(lum, 1.0e-5)), LOG_MIN, LOG_MAX);
        uint bin = min(uint(floor((logLum - LOG_MIN) * INV_LOG_RANGE * 256.0)), 255u);
        atomicAdd(localBins[bin], 1u);
    }

    barrier();
    uint count = localBins[localIdx];
    if (count > 0u) {
        atomicAdd(hist.bins[localIdx], count);
    }
}
