#version 460
layout(local_size_x=16,local_size_y=16) in;
layout(set=0,binding=0,r32f) uniform writeonly image2D outputAlpha;
layout(set=0,binding=1) uniform sampler2D afterUi;
layout(set=0,binding=2) uniform sampler2D beforeUi;
layout(push_constant) uniform Push { int delta; } pc;
void main() {
    ivec2 p=ivec2(gl_GlobalInvocationID.xy),s=imageSize(outputAlpha);
    if(any(greaterThanEqual(p,s)))return;
    ivec2 ins=textureSize(afterUi,0);
    ivec2 q=ivec2(min(p.x*ins.x/s.x,ins.x-1),ins.y-1-min(p.y*ins.y/s.y,ins.y-1));
    vec4 a=texelFetch(afterUi,q,0);
    float mask=a.a;
    if(pc.delta!=0) {
        vec3 d=abs(a.rgb-texelFetch(beforeUi,q,0).rgb);
        // Freeze only changed GUI/effect pixels at their actual composited colour. There is no
        // attempt to represent destination-dependent INVERT as a transparent premultiplied colour.
        mask=step(0.5/255.0,max(d.r,max(d.g,d.b)));
    }
    imageStore(outputAlpha,p,vec4(mask));
}
